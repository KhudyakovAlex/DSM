// Схема ядра DSM (учебная, только текущие сущности).
// Дублирует db/init.sql. Логика: сущности и связи, без координат.
// Сущности: Device, Link, Frame, Resource, Connector, Holder.
// Ресурсное соединение = пара Connector↔Connector; механическая привязка = пара Holder↔Holder.
// Представление: view + placement (геометрия в jsonb); новое представление не меняет логические таблицы.

Table resource {
  id integer [pk, increment]
  name text [not null, unique]

  Note: 'Профиль ресурса; один экземпляр на профиль во всей модели (вода, электричество 230В, данные DALI…)'
}

Table device {
  id integer [pk, increment]
  name text [not null]
  parent_device_id integer [ref: > device.id]

  Note: 'Устройство: преобразует, накапливает, отдаёт или регулирует ресурс. Составное Device содержит внутреннюю схему (Device + Link + Frame). Размещение — в placement'
}

Table link {
  id integer [pk, increment]
  name text [not null]
  resource_id integer [ref: > resource.id]
  parent_device_id integer [ref: > device.id]
  parent_link_id integer [ref: > link.id]

  Note: 'Соединение: пассивно передаёт ресурс без изменения его вида. Составной Link (кабель → жилы); может входить в состав Device. Трасса — в placement'
}

Table frame {
  id integer [pk, increment]
  name text [not null]
  parent_device_id integer [ref: > device.id]
  parent_frame_id integer [ref: > frame.id]

  Note: 'Несущая конструкция: ресурс не передаёт, коннекторов нет. Размещение — в placement'
}

Table connector {
  id integer [pk, increment]
  name text [not null]
  device_id integer [ref: > device.id]
  link_id integer [ref: > link.id]
  resource_id integer [ref: > resource.id]

  Note: 'Разъём: точка подключения ресурса. Ровно один владелец: Device или Link (CHECK connector_one_owner). Позиция — в placement'
}

Table holder {
  id integer [pk, increment]
  name text [not null]
  device_id integer [ref: > device.id]
  link_id integer [ref: > link.id]
  frame_id integer [ref: > frame.id]

  Note: 'Крепление: деталь или зона контакта. Ровно один владелец: Device, Link или Frame (CHECK holder_one_owner). Позиция — в placement'
}

Table connector_plug {
  id integer [pk, increment]
  connector_a_id integer [not null, ref: > connector.id]
  connector_b_id integer [not null, ref: > connector.id]

  Note: 'Пара Connector↔Connector (через Link или прямой контакт). CHECK a < b; UNIQUE (a, b)'
}

Table holder_plug {
  id integer [pk, increment]
  holder_a_id integer [not null, ref: > holder.id]
  holder_b_id integer [not null, ref: > holder.id]

  Note: 'Пара Holder↔Holder (контакт с Frame). CHECK a < b; UNIQUE (a, b)'
}

Table view {
  id integer [pk, increment]
  name text [not null, unique]

  Note: 'Представление модели: мнемосхема 2D, 3D и пр. Новое представление — новая запись, логическая схема не меняется'
}

Table placement {
  id integer [pk, increment]
  view_id integer [not null, ref: > view.id]
  entity_type text [not null]
  entity_id integer [not null]
  geom jsonb [not null]

  Note: 'Размещение сущности в представлении. Универсальная ссылка (entity_type + entity_id) без FK на логические таблицы; UNIQUE (view_id, entity_type, entity_id). geom: 2D {x, y[, w, h][, base_y]}, трасса Link {lines: [{line_no, points}]}'
}